{
  "name": "doubletake",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A second look at every AI answer, before the user acts on it.",
  "scripts": {
    "start": "bun run build:console && bun run src/server.ts",
    "dev": "bun run --watch src/server.ts",
    "dev:console": "cd console && bun run dev",
    "build:console": "cd console && bun install --silent && bun run build",
    "eval": "bun run scripts/run-eval.ts",
    "selfcheck": "bun run scripts/selfcheck.ts",
    "seed": "bun run scripts/seed-traffic.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "hono": "^4.6.14",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "shadcn": "^4.19.0",
    "typescript": "^5.7.2"
  },
  "trustedDependencies": [
    "onnxruntime-node",
    "protobufjs"
  ]
}
