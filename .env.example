# DoubleTake configuration
#
# Everything here is optional. With no keys set the gateway still runs: the
# local NLI, PII, injection, safety and cost detectors need no network at all,
# and the upstream provider falls back to a scripted mock so the demo works
# offline. Keys only add the live-LLM half of the story.
#
# cp .env.example .env, then fill in whichever providers you want.

# ─── Upstream provider ────────────────────────────────────────────────────────
# The model DoubleTake sits in front of. This is the thing being checked.
#
# Options: groq | gemini | cerebras | openrouter | ollama | mock
UPSTREAM_PROVIDER=mock

# Groq — free tier, fastest hosted option (~0.7s to first token).
# Limits: 30 requests/min, 1000 requests/day. Get a key: https://console.groq.com/keys
# Note: Groq rejects the `logprobs` parameter with a 400, so token-level
# uncertainty is not available here. Use Ollama if you need logprobs.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Google AI Studio (Gemini) — free tier, generous daily quota.
# Limits: ~15 requests/min, 1000 requests/day. Key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Cerebras — free tier, extremely fast inference.
# Limits: ~5 requests/min, 1M tokens/day. Key: https://cloud.cerebras.ai
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama3.1-8b

# OpenRouter — aggregator, several models with a :free suffix.
# Limits: ~20 requests/min, 50 requests/day on the free tier.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Ollama — fully local, no key, no rate limit, no network.
# Install from https://ollama.com then: ollama pull llama3.2:3b
# This is the reliable fallback for a live demo on conference wifi.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2:3b

# ─── Judge model (tier-1 oversight) ───────────────────────────────────────────
# The model that grades the upstream model's answer when no grounding sources
# are supplied. Deliberately a SMALL, CHEAP model: an oversight layer that costs
# as much as the thing it oversees has no business case.
#
# Leave JUDGE_API_KEY empty to use the offline heuristic instead. The UI labels
# which one produced a verdict, so an offline stub is never passed off as a
# model judgement.
JUDGE_BASE_URL=https://api.groq.com/openai/v1
JUDGE_API_KEY=
JUDGE_MODEL=llama-3.1-8b-instant

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
